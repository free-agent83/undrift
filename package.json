{
  "name": "undrift",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Checks every file a coding agent writes against a React and Tailwind design system's own rules, as it is written, and says what it did not check.",
  "keywords": [
    "design-system",
    "design-tokens",
    "tailwind",
    "react",
    "claude-code",
    "coding-agent",
    "lint"
  ],
  "author": "Chris Learey",
  "homepage": "https://github.com/free-agent83/undrift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/free-agent83/undrift.git"
  },
  "bugs": {
    "url": "https://github.com/free-agent83/undrift/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "undrift": "./bin/undrift.mjs"
  },
  "files": [
    "bin",
    "hooks",
    "src",
    "templates",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./unstable/*": "./src/*.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "culori": "^4.0.0",
    "fast-glob": "^3.3.3",
    "typescript": "~5.9.0"
  },
  "devDependencies": {
    "tailwindcss": "4.3.2",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "tinypool": "^2.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
